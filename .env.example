# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
# Public origin of the app. Used for absolute links and cookie security decisions.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# The migration enables the `btree_gist` extension, which requires a role with
# sufficient privileges on first deploy.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinic_ai?schema=public

# Optional: separate database used by `npm test` for integration tests.
# When unset, DB-backed integration tests are skipped and only pure-logic tests run.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets — generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
# Signs session JWTs. Rotating this logs every user out. Min 32 chars.
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# AES-256-GCM key for encrypting integration credentials at rest.
# Must be exactly 32 bytes, base64-encoded: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-base64-encoded-32-byte-key====
# Shared secret required by the /api/cron/* endpoints (Authorization: Bearer <secret>).
CRON_SECRET=replace-me-with-a-long-random-string

# Session lifetime in seconds (default 8 hours).
SESSION_TTL_SECONDS=28800

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Overridable without code changes. Per-clinic override lives in AIConfiguration.model.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# Token echoed back during Meta's webhook verification handshake (GET challenge).
# Per-clinic verify tokens are stored encrypted on WhatsAppIntegration; this is the
# platform-level fallback used for the shared webhook URL.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret used to validate the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# The default limiter is in-process and therefore per-instance. Set this to a
# Redis URL in production for a shared counter across instances.
RATE_LIMIT_REDIS_URL=

# ---------------------------------------------------------------------------
# Bootstrap (seed only)
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
