// Clinic AI WhatsApp Appointment Platform — data model.
//
// Conventions used throughout:
//   * Every tenant-owned table carries `clinicId` and indexes it. Authorization is
//     enforced in the service layer by always threading a tenant scope into queries.
//   * All instants are stored as `timestamptz` (Prisma `DateTime`) in UTC. Wall-clock
//     interpretation always goes through the owning clinic's IANA timezone.
//   * Weekdays are ISO-8601: 1 = Monday ... 7 = Sunday (matches Luxon's `weekday`).
//   * Local time-of-day is stored as minutes-from-midnight (0..1440) so it is
//     timezone- and DST-agnostic until resolved against a concrete date.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  CLIENT
  COORDINATOR
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED // superseded by a newer appointment; the original slot is released
  COMPLETED
  NO_SHOW
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  BOOKED
  LOST
}

enum ConversationStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  PATIENT
  AI
  HUMAN
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum AppointmentSource {
  AI_WHATSAPP
  ADMIN
  IMPORT
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String? @unique
  phone        String?
  passwordHash String
  name         String
  role         Role    @default(CLIENT)
  isActive          Boolean @default(true)
  salary            Float?  @default(0)
  commissionPercent Float?  @default(0)

  /// Null for SUPER_ADMIN (platform-wide). Required for CLIENT and PATIENT (tenant-bound).
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Bumped to invalidate every issued session for this user.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  auditLogs          AuditLog[]
  appointments       Appointment[] @relation("AppointmentCreatedBy")
  messages           Message[]     @relation("MessageSentByUser")
  patient            Patient?      @relation("PatientUser")
  doctor             Doctor?       @relation("DoctorUser")
  coordinatedDoctors Doctor[]      @relation("DoctorCoordinator")

  createdStockMovements   InventoryStockMovement[] @relation("StockMovementCreatedBy")
  createdPurchaseOrders   PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  requestedItemRequests   ItemRequest[]            @relation("ItemRequestRequestedBy")
  approvedItemRequests    ItemRequest[]            @relation("ItemRequestApprovedBy")
  releasedItemRequests    ItemRequest[]            @relation("ItemRequestReleasedBy")

  createdInvoices         Invoice[]                @relation("InvoiceCreatedBy")
  receivedPayments        PaymentTransaction[]     @relation("PaymentReceivedBy")
  createdDoctorPayouts    DoctorPayout[]           @relation("DoctorPayoutCreatedBy")
  createdClinicExpenses   ClinicExpense[]          @relation("ClinicExpenseCreatedBy")
  closedDayEndClosings    DayEndClosing[]          @relation("DayEndClosedBy")
  verifiedDayEndClosings  DayEndClosing[]          @relation("DayEndVerifiedBy")

  @@index([clinicId])
  @@index([role])
  @@index([username])
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model Clinic {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  pulseHealthOS Boolean @default(true)
  pulseNow      Boolean @default(false)

  phone          String?
  whatsappNumber String?
  email          String?
  website        String?
  addressLine    String?
  city           String?
  country        String?

  /// IANA timezone, e.g. "Asia/Karachi". Never assume the server timezone.
  timezone String @default("Asia/Riyadh")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users           User[]
  settings        ClinicSettings?
  aiConfiguration AIConfiguration?
  whatsapp        WhatsAppIntegration?
  hours           ClinicHours[]
  holidays        Holiday[]
  specialClosures SpecialClosure[]
  doctors         Doctor[]
  services        Service[]
  faqs            FAQ[]
  patients        Patient[]
  leads           Lead[]
  conversations   Conversation[]
  messages        Message[]
  appointments    Appointment[]
  reminders       Reminder[]
  reminderRules   ReminderRule[]
  auditLogs       AuditLog[]
  systemLogs      SystemLog[]

  inventoryCategories     InventoryCategory[]
  inventorySuppliers      Supplier[]
  inventoryItems          InventoryItem[]
  inventoryBatches        InventoryBatch[]
  inventoryStockMovements InventoryStockMovement[]
  purchaseOrders          PurchaseOrder[]
  itemRequests            ItemRequest[]

  invoices                Invoice[]
  paymentTransactions     PaymentTransaction[]
  doctorPayouts           DoctorPayout[]
  supplierBills           SupplierBill[]
  supplierPayments        SupplierPayment[]
  clinicExpenses          ClinicExpense[]
  dayEndClosings          DayEndClosing[]

  @@index([isActive])
}

model ClinicSettings {
  id       String @id @default(uuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Fallback appointment length when a service does not specify one.
  defaultAppointmentMinutes Int @default(30)
  /// Gap enforced after each appointment before the next may start.
  defaultBufferMinutes      Int @default(0)
  /// Granularity of offered start times.
  slotGranularityMinutes    Int @default(15)

  /// Booking window guards.
  minAdvanceBookingMinutes Int     @default(60)
  maxAdvanceBookingDays    Int     @default(60)
  /// Patients may not cancel/reschedule inside this window.
  cancellationCutoffHours  Int     @default(4)
  allowPatientCancellation Boolean @default(true)
  allowPatientReschedule   Boolean @default(true)

  cancellationPolicy  String?
  reschedulingPolicy  String?
  /// Max slots offered to a patient in one message.
  maxSlotsOfferedToAI Int     @default(5)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ClinicHours {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday     Int
  /// Minutes from local midnight.
  startMinute Int
  endMinute   Int
  isClosed    Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([clinicId, weekday])
}

model Holiday {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name                String
  /// Local calendar date in the clinic timezone, stored as YYYY-MM-DD.
  date                String
  isRecurringAnnually Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([clinicId, date, name])
  @@index([clinicId, date])
}

model SpecialClosure {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  reason      String?
  /// Inclusive local date range in the clinic timezone (YYYY-MM-DD).
  startDate   String
  endDate     String
  /// Optional intra-day window; null means the whole day is closed.
  startMinute Int?
  endMinute   Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([clinicId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Providers & catalogue
// ---------------------------------------------------------------------------

model Doctor {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name        String
  specialty   String?
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)

  /// Per-doctor overrides; fall back to ClinicSettings when null.
  appointmentMinutes Int?
  bufferMinutes      Int?

  coordinatorId String?
  coordinator   User?   @relation("DoctorCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)

  phone  String?
  userId String? @unique
  user   User?   @relation("DoctorUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  schedules        DoctorSchedule[]
  breaks           DoctorBreak[]
  timeOff          DoctorTimeOff[]
  services         DoctorService[]
  appointments     Appointment[]
  paymentStructure DoctorPaymentStructure?
  invoices         Invoice[]
  payouts          DoctorPayout[]

  @@index([clinicId, isActive])
  @@index([coordinatorId])
}

model DoctorSchedule {
  id       String @id @default(uuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId String

  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday     Int
  startMinute Int
  endMinute   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([doctorId, weekday])
  @@index([clinicId])
}

model DoctorBreak {
  id       String @id @default(uuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId String

  label       String?
  weekday     Int
  startMinute Int
  endMinute   Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([doctorId, weekday])
  @@index([clinicId])
}

model DoctorTimeOff {
  id       String @id @default(uuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId String

  reason      String?
  /// Inclusive local date range (YYYY-MM-DD) in the clinic timezone.
  startDate   String
  endDate     String
  startMinute Int?
  endMinute   Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([doctorId, startDate, endDate])
  @@index([clinicId])
}

model DoctorPaymentStructure {
  id                      String   @id @default(uuid())
  clinicId                String
  doctorId                String   @unique
  doctor                  Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  /// Fixed monthly base payment in SAR (0 for commission-only).
  fixedMonthlyAmount      Float    @default(0)
  /// Incentive on collected revenue percentage (0..100).
  revenueIncentivePercent Float    @default(0)
  /// Procedure fee type: "FIXED" | "PERCENTAGE".
  procedureFeeType        String   @default("PERCENTAGE")
  /// Fixed amount per procedure in SAR (when procedureFeeType is "FIXED").
  procedureFeeAmount      Float?   @default(0)
  /// Percentage share of procedure value (when procedureFeeType is "PERCENTAGE").
  procedureFeePercent     Float?   @default(0)

  otherPayments           DoctorOtherPayment[]

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@index([clinicId])
  @@index([doctorId])
}

model DoctorOtherPayment {
  id                 String                 @id @default(uuid())
  paymentStructureId String
  paymentStructure   DoctorPaymentStructure @relation(fields: [paymentStructureId], references: [id], onDelete: Cascade)

  label              String
  /// Type: "AMOUNT" | "PERCENTAGE".
  type               String                 @default("AMOUNT")
  value              Float                  @default(0)

  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)

  @@index([paymentStructureId])
}

model Service {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  durationMinutes Int
  bufferMinutes   Int?
  /// Minor units (e.g. cents/paisa) to avoid float rounding on money.
  priceMinor      Int?
  currency        String? @default("SAR")
  isActive        Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctors      DoctorService[]
  appointments Appointment[]
  invoiceItems InvoiceItem[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
}

model DoctorService {
  doctorId  String
  serviceId String
  clinicId  String

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
  @@index([serviceId])
  @@index([clinicId])
}

model FAQ {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  question  String
  answer    String
  category  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([clinicId, isActive])
}

// ---------------------------------------------------------------------------
// AI & WhatsApp configuration (internal-only; never exposed to CLIENT users)
// ---------------------------------------------------------------------------

model AIConfiguration {
  id       String @id @default(uuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  assistantName      String   @default("Assistant")
  greeting           String?
  tone               String   @default("professional, warm, concise")
  personality        String?
  primaryLanguage    String   @default("en")
  supportedLanguages String[] @default(["en"])

  /// Extra operator instructions appended to the system prompt.
  customInstructions String?
  /// Free-text conditions under which the agent must hand off to a human.
  escalationRules    String?
  escalationKeywords String[] @default([])

  model           String  @default("gemini-3.6-flash")
  temperature     Float   @default(0.3)
  maxOutputTokens Int     @default(1024)
  /// Turns of history replayed into the model.
  historyWindow   Int     @default(20)
  isEnabled       Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model WhatsAppIntegration {
  id       String @id @default(uuid())
  clinicId String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Meta Cloud API phone number id — used to route inbound webhooks to a tenant.
  phoneNumberId      String  @unique
  wabaId             String?
  displayPhoneNumber String?

  /// AES-256-GCM ciphertext. Plaintext never leaves the server.
  accessTokenCipher String?
  appSecretCipher   String?
  verifyTokenCipher String?

  isActive    Boolean   @default(false)
  lastError   String?
  lastErrorAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ReminderRule {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// How long before the appointment start this reminder fires.
  offsetMinutes Int
  /// Optional override; falls back to a built-in template.
  template      String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reminders Reminder[]

  @@unique([clinicId, offsetMinutes])
  @@index([clinicId, isActive])
}

// ---------------------------------------------------------------------------
// People & funnel
// ---------------------------------------------------------------------------

model Patient {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Sequential unique medical record / file number within the clinic (e.g. 1, 2, 3...)
  fileNumber Int?

  title          String?
  gender         String?
  nationality    String?
  name           String?
  /// E.164 without the leading '+', as delivered by the WhatsApp Cloud API.
  phone          String
  whatsappNumber String?
  email          String?
  notes          String?
  tags           String[] @default([])

  userId String? @unique
  user   User?   @relation("PatientUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  lead          Lead?
  conversations Conversation[]
  appointments  Appointment[]
  invoices      Invoice[]
  payments      PaymentTransaction[]

  @@unique([clinicId, phone])
  @@unique([clinicId, fileNumber])
  @@index([clinicId])
  @@index([clinicId, fileNumber])
}

model Lead {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  status LeadStatus @default(NEW)
  source String     @default("whatsapp")
  notes  String?
  tags   String[]   @default([])

  firstContactAt DateTime  @default(now()) @db.Timestamptz(3)
  lastContactAt  DateTime  @default(now()) @db.Timestamptz(3)
  qualifiedAt    DateTime? @db.Timestamptz(3)
  bookedAt       DateTime? @db.Timestamptz(3)
  lostAt         DateTime? @db.Timestamptz(3)
  lostReason     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointments Appointment[]

  @@index([clinicId, status])
  @@index([clinicId, createdAt])
}

// ---------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  status             ConversationStatus @default(ACTIVE)
  /// Set when the agent hands the thread to a human.
  escalatedAt        DateTime?          @db.Timestamptz(3)
  escalationReason   String?
  /// Denormalised for fast inbox sorting.
  lastMessageAt      DateTime           @default(now()) @db.Timestamptz(3)
  lastMessagePreview String?
  aiEnabled          Boolean            @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  messages Message[]

  @@index([clinicId, lastMessageAt])
  @@index([clinicId, status])
  @@index([patientId])
}

model Message {
  id             String       @id @default(uuid())
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction    MessageDirection
  sender       MessageSender
  /// Set when a human operator sent the message.
  sentByUserId String?
  sentByUser   User?            @relation("MessageSentByUser", fields: [sentByUserId], references: [id], onDelete: SetNull)

  body     String
  mediaUrl String?
  status   MessageStatus @default(PENDING)
  error    String?

  /// Provider message id. Unique per clinic so redelivered webhooks are no-ops.
  externalId String?
  /// Structured record of any tool calls the agent made on this turn.
  toolCalls  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([clinicId, externalId])
  @@index([conversationId, createdAt])
  @@index([clinicId, createdAt])
}

/// Webhook / job de-duplication ledger. Insert-wins: a duplicate insert throws
/// a unique violation, which callers treat as "already handled".
model ProcessedEvent {
  id        String   @id @default(uuid())
  scope     String
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

model Appointment {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  /// Sequential unique appointment number per clinic, starting from 1.
  appointmentNumber Int?

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// UTC instants. This is the appointment as the patient experiences it, and
  /// the only pair that should ever be displayed.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  /// Buffer snapshot (doctor override, else service, else clinic default).
  bufferMinutes Int      @default(0)
  /// The interval this appointment actually *occupies* on the doctor's calendar:
  /// `blockStartsAt == startsAt` and `blockEndsAt == endsAt + bufferMinutes`.
  /// Denormalised so the exclusion constraint can be an immutable column
  /// expression — that is what makes buffer time enforceable by the database
  /// rather than only by the availability engine.
  blockStartsAt DateTime @db.Timestamptz(3)
  blockEndsAt   DateTime @db.Timestamptz(3)

  /// Snapshot of the clinic timezone at booking time, for stable rendering.
  timezone String

  status         AppointmentStatus @default(CONFIRMED)
  source         AppointmentSource @default(AI_WHATSAPP)
  notes          String?
  pendingPayment String?

  /// Caller-supplied de-duplication key; a retried tool call returns the
  /// original appointment instead of creating a second one.
  idempotencyKey String? @unique

  createdByUserId String?
  createdBy       User?   @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  confirmedAt  DateTime? @db.Timestamptz(3)
  cancelledAt  DateTime? @db.Timestamptz(3)
  cancelReason String?
  completedAt  DateTime? @db.Timestamptz(3)
  noShowAt     DateTime? @db.Timestamptz(3)

  /// Set on the NEW appointment, pointing at the one it replaced.
  rescheduledFromId String?      @unique
  rescheduledFrom   Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("Reschedule")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  reminders Reminder[]
  invoice   Invoice?

  @@unique([clinicId, appointmentNumber])
  @@index([clinicId, startsAt])
  @@index([clinicId, status, startsAt])
  @@index([doctorId, startsAt])
  @@index([doctorId, blockStartsAt, blockEndsAt])
  @@index([patientId, startsAt])
  @@index([leadId])
  @@index([serviceId])
}

model Reminder {
  id       String @id @default(uuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointmentId String
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  ruleId        String?
  rule          ReminderRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  offsetMinutes Int
  scheduledFor  DateTime       @db.Timestamptz(3)
  status        ReminderStatus @default(SCHEDULED)
  sentAt        DateTime?      @db.Timestamptz(3)
  attempts      Int            @default(0)
  lastError     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// One reminder per appointment per offset — makes re-scheduling idempotent.
  @@unique([appointmentId, offsetMinutes])
  @@index([status, scheduledFor])
  @@index([clinicId, scheduledFor])
}

// ---------------------------------------------------------------------------
// Observability
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(uuid())
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorLabel  String?

  action     String
  entityType String
  entityId   String?
  /// Redacted diff/metadata. Never contains secrets.
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([clinicId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

model SystemLog {
  id       String  @id @default(uuid())
  clinicId String?
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  level   LogLevel
  event   String
  message String
  context Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([level, createdAt])
  @@index([clinicId, createdAt])
  @@index([event, createdAt])
}

// ---------------------------------------------------------------------------
// Inventory & Supply Chain Enums
// ---------------------------------------------------------------------------

enum StockMovementType {
  STOCK_RECEIVED
  STOCK_ISSUED
  STOCK_ADJUSTMENT
  STOCK_RETURN
  STOCK_TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ItemRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RELEASED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Inventory & Supply Chain Models
// ---------------------------------------------------------------------------

model InventoryCategory {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  items InventoryItem[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model Supplier {
  id            String   @id @default(uuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  taxNumber     String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]

  @@index([clinicId])
  @@index([isActive])
}

model InventoryItem {
  id           String   @id @default(uuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name         String
  sku          String?
  unit         String   @default("PCS")
  description  String?
  currentStock Int      @default(0)
  minimumStock Int      @default(0)
  defaultCost  Float?   @default(0)
  trackExpiry  Boolean  @default(false)
  trackBatch   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  movements    InventoryStockMovement[]
  batches      InventoryBatch[]
  poItems      PurchaseOrderItem[]
  requestItems ItemRequestItem[]
  invoiceItems InvoiceItem[]

  @@unique([clinicId, sku])
  @@index([clinicId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([isActive])
}

model InventoryBatch {
  id           String    @id @default(uuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchNumber  String
  expiryDate   DateTime? @db.Timestamptz(3)
  quantity     Int       @default(0)
  unitCost     Float?    @default(0)
  receivedDate DateTime  @default(now()) @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  movements InventoryStockMovement[]

  @@index([clinicId])
  @@index([itemId])
  @@index([expiryDate])
}

model InventoryStockMovement {
  id            String            @id @default(uuid())
  clinicId      String
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         InventoryBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type          StockMovementType
  quantity      Int
  previousStock Int
  newStock      Int
  unitCost      Float?
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?
  createdBy     User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@index([clinicId, createdAt])
  @@index([itemId])
  @@index([type])
  @@index([createdById])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  clinicId     String
  clinic       Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  poNumber     String
  orderDate    DateTime            @default(now()) @db.Timestamptz(3)
  expectedDate DateTime?           @db.Timestamptz(3)
  status       PurchaseOrderStatus @default(DRAFT)
  totalAmount  Float               @default(0)
  notes        String?
  createdById  String?
  createdBy    User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  items PurchaseOrderItem[]
  bills SupplierBill[]

  @@unique([clinicId, poNumber])
  @@index([clinicId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity         Int
  receivedQuantity Int           @default(0)
  unitCost         Float         @default(0)
  totalCost        Float         @default(0)

  @@index([purchaseOrderId])
  @@index([itemId])
}

model ItemRequest {
  id              String            @id @default(uuid())
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  requestNumber   String
  requestedById   String
  requestedBy     User              @relation("ItemRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  department      String?
  status          ItemRequestStatus @default(PENDING)
  requestDate     DateTime          @default(now()) @db.Timestamptz(3)
  approvedAt      DateTime?         @db.Timestamptz(3)
  approvedById    String?
  approvedBy      User?             @relation("ItemRequestApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  releasedAt      DateTime?         @db.Timestamptz(3)
  releasedById    String?
  releasedBy      User?             @relation("ItemRequestReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  notes           String?
  rejectionReason String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  items ItemRequestItem[]

  @@unique([clinicId, requestNumber])
  @@index([clinicId])
  @@index([requestedById])
  @@index([status])
}

model ItemRequestItem {
  id                String        @id @default(uuid())
  itemRequestId     String
  itemRequest       ItemRequest   @relation(fields: [itemRequestId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requestedQuantity Int
  releasedQuantity  Int           @default(0)

  @@index([itemRequestId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Accounts & Finance Enums
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  ONLINE
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  MAINTENANCE
  MEDICAL_SUPPLIES
  OFFICE_SUPPLIES
  OTHER
}

enum ClosingStatus {
  DRAFT
  SUBMITTED
  VERIFIED
}

// ---------------------------------------------------------------------------
// Accounts & Finance Models
// ---------------------------------------------------------------------------

model Invoice {
  id             String        @id @default(uuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  appointmentId  String?       @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?       @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  issueDate      DateTime      @default(now()) @db.Timestamptz(3)
  dueDate        DateTime?     @db.Timestamptz(3)
  status         InvoiceStatus @default(ISSUED)
  subtotal       Float         @default(0)
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  totalAmount    Float         @default(0)
  paidAmount     Float         @default(0)
  currency       String        @default("SAR")
  notes          String?
  createdById    String?
  createdBy      User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  items        InvoiceItem[]
  transactions PaymentTransaction[]

  @@unique([clinicId, invoiceNumber])
  @@index([clinicId, issueDate])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([doctorId])
}

model InvoiceItem {
  id              String         @id @default(uuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  description     String
  quantity        Int            @default(1)
  unitPrice       Float          @default(0)
  totalPrice      Float          @default(0)

  @@index([invoiceId])
  @@index([serviceId])
  @@index([inventoryItemId])
}

model PaymentTransaction {
  id           String        @id @default(uuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  amount       Float
  method       PaymentMethod @default(CASH)
  reference    String?
  notes        String?
  paymentDate  DateTime      @default(now()) @db.Timestamptz(3)
  receivedById String?
  receivedBy   User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([clinicId, paymentDate])
  @@index([invoiceId])
  @@index([patientId])
  @@index([method])
}

model DoctorPayout {
  id               String       @id @default(uuid())
  clinicId         String
  clinic           Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  payoutNumber     String
  periodStart      DateTime     @db.Timestamptz(3)
  periodEnd        DateTime     @db.Timestamptz(3)
  totalRevenue     Float        @default(0)
  baseSalary       Float        @default(0)
  commissionAmount Float        @default(0)
  deductions       Float        @default(0)
  netPayoutAmount  Float        @default(0)
  status           PayoutStatus @default(PENDING)
  paidAt           DateTime?    @db.Timestamptz(3)
  paymentMethod    String?
  notes            String?
  createdById      String?
  createdBy        User?        @relation("DoctorPayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([clinicId, payoutNumber])
  @@index([clinicId, periodStart, periodEnd])
  @@index([doctorId])
  @@index([status])
}

model SupplierBill {
  id              String         @id @default(uuid())
  clinicId        String
  clinic          Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  billNumber      String
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  billDate        DateTime       @default(now()) @db.Timestamptz(3)
  dueDate         DateTime?      @db.Timestamptz(3)
  totalAmount     Float          @default(0)
  paidAmount      Float          @default(0)
  status          BillStatus     @default(UNPAID)
  notes           String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  payments SupplierPayment[]

  @@unique([clinicId, billNumber])
  @@index([clinicId, billDate])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
}

model SupplierPayment {
  id          String       @id @default(uuid())
  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  billId      String
  bill        SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Float
  method      String       @default("BANK_TRANSFER")
  reference   String?
  paymentDate DateTime     @default(now()) @db.Timestamptz(3)
  notes       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([clinicId, paymentDate])
  @@index([billId])
}

model ClinicExpense {
  id            String          @id @default(uuid())
  clinicId      String
  clinic        Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  expenseNumber String
  category      ExpenseCategory @default(OTHER)
  title         String
  amount        Float
  paymentMethod PaymentMethod   @default(BANK_TRANSFER)
  paidTo        String?
  expenseDate   DateTime        @default(now()) @db.Timestamptz(3)
  receiptUrl    String?
  notes         String?
  createdById   String?
  createdBy     User?           @relation("ClinicExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([clinicId, expenseNumber])
  @@index([clinicId, expenseDate])
  @@index([clinicId, category])
}

model DayEndClosing {
  id               String        @id @default(uuid())
  clinicId         String
  clinic           Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  closingNumber    String
  closingDate      String
  closedByUserId   String
  closedByUser     User          @relation("DayEndClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  openingCash      Float         @default(0)
  expectedCash     Float         @default(0)
  countedCash      Float         @default(0)
  cashDifference   Float         @default(0)
  totalCardAmount  Float         @default(0)
  totalBankAmount  Float         @default(0)
  totalRevenue     Float         @default(0)
  status           ClosingStatus @default(SUBMITTED)
  notes            String?
  verifiedByUserId String?
  verifiedByUser   User?         @relation("DayEndVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedAt       DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([clinicId, closingDate])
  @@unique([clinicId, closingNumber])
  @@index([clinicId, closingDate])
  @@index([closedByUserId])
}

